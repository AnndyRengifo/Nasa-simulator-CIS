  m_Script: {fileID: 11500000, guid: 51bac46a0a5a8b34380bcdb201271174, type: 3}
  m_Name: SUB_ending_partial_es
  m_EditorClassIdentifier: SOL3.Cinematics::Sol3.Cinematics.SubtitleSheet
  cinematicId: ending_partial
  language: es
  lines:
  - lineId: ending_partial_010
    speaker: {fileID: 11400000, guid: 557542bb9b0eed34bbe6efcc9af63401, type: 2}
    text: "La tripulaci\xF3n est\xE1 a salvo."
    startTime: 1.5
    endTime: 4.5
    voiceClip: {fileID: 0}
    voiceVolume: 1
  - lineId: ending_partial_020
    speaker: {fileID: 11400000, guid: 557542bb9b0eed34bbe6efcc9af63401, type: 2}
    text: No hemos podido terminar todos los experimentos.
    startTime: 9
    endTime: 13
    voiceClip: {fileID: 0}
    voiceVolume: 1
  - lineId: ending_partial_030
    speaker: {fileID: 11400000, guid: 557542bb9b0eed34bbe6efcc9af63401, type: 2}
    text: "Pero aprendimos algo fundamental: en una misi\xF3n espacial, proteger la vida siempre es una prioridad."
    startTime: 22.5
    endTime: 30
    voiceClip: {fileID: 0}
    voiceVolume: 1
