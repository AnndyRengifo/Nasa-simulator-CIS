%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51bac46a0a5a8b34380bcdb201271174, type: 3}
  m_Name: SUB_intro_es
  m_EditorClassIdentifier: SOL3.Cinematics::Sol3.Cinematics.SubtitleSheet
  cinematicId: intro
  language: es
  lines:
  - lineId: intro_010
    speaker: {fileID: 11400000, guid: a61081a42a6659a46aa490529e6fdd85, type: 2}
    text: Durante generaciones, observamos Marte desde la distancia...
    startTime: 0.8
    endTime: 5.8
    voiceClip: {fileID: 0}
    voiceVolume: 1
  - lineId: intro_020
    speaker: {fileID: 11400000, guid: a61081a42a6659a46aa490529e6fdd85, type: 2}
    text: "...hasta que finalmente aprendimos a vivir aqu\xED."
    startTime: 6.2
    endTime: 9.8
    voiceClip: {fileID: 0}
    voiceVolume: 1
  - lineId: intro_030
    speaker: {fileID: 11400000, guid: a61081a42a6659a46aa490529e6fdd85, type: 2}
    text: "Esta es Aurora. Una base experimental construida para descubrir c\xF3mo sobrevivir lejos de la Tierra."
    startTime: 13
    endTime: 20.5
    voiceClip: {fileID: 0}
    voiceVolume: 1
  - lineId: intro_040
    speaker: {fileID: 11400000, guid: 557542bb9b0eed34bbe6efcc9af63401, type: 2}
    text: Bienvenido a Base Aurora.
    startTime: 53
    endTime: 55.8
    voiceClip: {fileID: 0}
    voiceVolume: 1
  - lineId: intro_050
    speaker: {fileID: 11400000, guid: 557542bb9b0eed34bbe6efcc9af63401, type: 2}
    text: "Soy AURA, tu asistente de misi\xF3n."
    startTime: 56.2
    endTime: 59.6
    voiceClip: {fileID: 0}
    voiceVolume: 1
  - lineId: intro_060
    speaker: {fileID: 11400000, guid: 557542bb9b0eed34bbe6efcc9af63401, type: 2}
    text: "Durante los pr\xF3ximos tres soles, nuestra supervivencia depender\xE1 de tus decisiones."
    startTime: 60
    endTime: 66
    voiceClip: {fileID: 0}
    voiceVolume: 1
  - lineId: intro_070
    speaker: {fileID: 11400000, guid: 557542bb9b0eed34bbe6efcc9af63401, type: 2}
    text: "Todos los sistemas est\xE1n operativos."
    startTime: 66.5
    endTime: 69.5
    voiceClip: {fileID: 0}
    voiceVolume: 1
  - lineId: intro_080
    speaker: {fileID: 11400000, guid: 557542bb9b0eed34bbe6efcc9af63401, type: 2}
    text: Por ahora.
    startTime: 70.6
    endTime: 72.6
    voiceClip: {fileID: 0}
    voiceVolume: 1
