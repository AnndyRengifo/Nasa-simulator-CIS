  m_Script: {fileID: 11500000, guid: 51bac46a0a5a8b34380bcdb201271174, type: 3}
  m_Name: SUB_solar_alert_es
  m_EditorClassIdentifier: SOL3.Cinematics::Sol3.Cinematics.SubtitleSheet
  cinematicId: solar_alert
  language: es
  lines:
  - lineId: solar_alert_010
    speaker: {fileID: 11400000, guid: 557542bb9b0eed34bbe6efcc9af63401, type: 2}
    text: "Atenci\xF3n. Hemos recibido informaci\xF3n sobre actividad solar."
    startTime: 1
    endTime: 5.5
    voiceClip: {fileID: 0}
    voiceVolume: 1
  - lineId: solar_alert_020
    speaker: {fileID: 11400000, guid: 557542bb9b0eed34bbe6efcc9af63401, type: 2}
    text: "Debemos revisar las condiciones de seguridad de la tripulaci\xF3n."
    startTime: 12
    endTime: 17
    voiceClip: {fileID: 0}
    voiceVolume: 1
  - lineId: solar_alert_030
    speaker: {fileID: 11400000, guid: 557542bb9b0eed34bbe6efcc9af63401, type: 2}
    text: Podemos interrumpir las actividades exteriores, preparar el refugio y proteger los recursos esenciales.
    startTime: 19.5
    endTime: 26.5
    voiceClip: {fileID: 0}
    voiceVolume: 1
  - lineId: solar_alert_040
    speaker: {fileID: 11400000, guid: 557542bb9b0eed34bbe6efcc9af63401, type: 2}
    text: "Pero tendremos que decidir qu\xE9 operaciones detener."
    startTime: 34.5
    endTime: 39.5
    voiceClip: {fileID: 0}
    voiceVolume: 1
