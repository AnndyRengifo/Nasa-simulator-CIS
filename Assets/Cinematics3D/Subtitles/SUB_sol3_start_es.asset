  m_Script: {fileID: 11500000, guid: 51bac46a0a5a8b34380bcdb201271174, type: 3}
  m_Name: SUB_sol3_start_es
  m_EditorClassIdentifier: SOL3.Cinematics::Sol3.Cinematics.SubtitleSheet
  cinematicId: sol3_start
  language: es
  lines:
  - lineId: sol3_start_010
    speaker: {fileID: 11400000, guid: 557542bb9b0eed34bbe6efcc9af63401, type: 2}
    text: "Hemos llegado al \xFAltimo sol de nuestra prueba."
    startTime: 1.5
    endTime: 5.5
    voiceClip: {fileID: 0}
    voiceVolume: 1
  - lineId: sol3_start_020
    speaker: {fileID: 11400000, guid: 557542bb9b0eed34bbe6efcc9af63401, type: 2}
    text: "Pero la misi\xF3n todav\xEDa no ha terminado."
    startTime: 9.5
    endTime: 13
    voiceClip: {fileID: 0}
    voiceVolume: 1
  - lineId: sol3_start_030
    speaker: {fileID: 11400000, guid: 557542bb9b0eed34bbe6efcc9af63401, type: 2}
    text: "Debemos mantener los sistemas esenciales, completar nuestra investigaci\xF3n y transmitir los resultados."
    startTime: 24.5
    endTime: 32
    voiceClip: {fileID: 0}
    voiceVolume: 1
  - lineId: sol3_start_040
    speaker: {fileID: 11400000, guid: 557542bb9b0eed34bbe6efcc9af63401, type: 2}
    text: El futuro de Aurora depende de lo que hagamos hoy.
    startTime: 33
    endTime: 38
    voiceClip: {fileID: 0}
    voiceVolume: 1
