  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51bac46a0a5a8b34380bcdb201271174, type: 3}
  m_Name: SUB_ending_success_es
  m_EditorClassIdentifier: SOL3.Cinematics::Sol3.Cinematics.SubtitleSheet
  cinematicId: ending_success
  language: es
  lines:
  - lineId: ending_success_010
    speaker: {fileID: 11400000, guid: 557542bb9b0eed34bbe6efcc9af63401, type: 2}
    text: "Transmisi\xF3n completada."
    startTime: 15.5
    endTime: 18
    voiceClip: {fileID: 0}
    voiceVolume: 1
  - lineId: ending_success_020
    speaker: {fileID: 11400000, guid: 557542bb9b0eed34bbe6efcc9af63401, type: 2}
    text: Nuestros resultados han sido enviados a la Tierra.
    startTime: 18.5
    endTime: 22.5
    voiceClip: {fileID: 0}
    voiceVolume: 1
  - lineId: ending_success_030
    speaker: {fileID: 11400000, guid: a61081a42a6659a46aa490529e6fdd85, type: 2}
    text: Base Aurora, hemos recibido su informe.
    startTime: 23
    endTime: 27
    voiceClip: {fileID: 0}
    voiceVolume: 1
  - lineId: ending_success_040
    speaker: {fileID: 11400000, guid: a61081a42a6659a46aa490529e6fdd85, type: 2}
    text: "Excelente trabajo, tripulaci\xF3n."
    startTime: 27.5
    endTime: 30.5
    voiceClip: {fileID: 0}
    voiceVolume: 1
  - lineId: ending_success_050
    speaker: {fileID: 11400000, guid: 557542bb9b0eed34bbe6efcc9af63401, type: 2}
    text: "Superamos la misi\xF3n gracias a nuestras decisiones."
    startTime: 32
    endTime: 36
    voiceClip: {fileID: 0}
    voiceVolume: 1
  - lineId: ending_success_060
    speaker: {fileID: 11400000, guid: 557542bb9b0eed34bbe6efcc9af63401, type: 2}
    text: "Cada recurso que protegimos nos permiti\xF3 llegar hasta aqu\xED."
    startTime: 36.5
    endTime: 41.5
    voiceClip: {fileID: 0}
    voiceVolume: 1
